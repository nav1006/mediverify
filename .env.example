# Copy to .env and fill in. Any blank/absent provider => that phase mocks
# (in --mock) or degrades gracefully (in live mode).

# Force everything to simulate regardless of keys:
MOCK=false

# ── Phase 0 — HLR pre-screen (Neutrino API) ──────────────────────────
# Sign up at https://www.neutrinoapi.com/ (verified account needed for
# unrestricted use). Auth is two values: User-ID and API-Key from your
# dashboard. Leave blank to run Phase 0 as format-only validation (still
# filters landlines and junk, just no live carrier lookup).
# Neutrino only bills for real mobile lookups — landline/VOIP are free.
NEUTRINO_USER_ID=
NEUTRINO_API_KEY=
NEUTRINO_COUNTRY_CODE=IN

# ── Phase 1 — Bland.ai voice call ────────────────────────────────────
BLAND_API_KEY=
# BLAND_FROM_NUMBER: leave BLANK unless you have PURCHASED a number on your
# Bland dashboard. Setting a number you don't own causes:
#   400 "Invalid 'from' - you might not own this number"
# Blank = Bland uses its own default caller number (correct for demos).
BLAND_FROM_NUMBER=
BLAND_VOICE=maya
# ISO-style code. "eng" or "hin". Do NOT use "babel" — it is invalid and 400s.
BLAND_LANGUAGE=eng
BLAND_MAX_DURATION=5
# Wait for the callee to say "hello" before the agent speaks. Strongly
# recommended — without it the agent talks over the greeting and calls drop.
BLAND_WAIT_FOR_GREETING=true
BLAND_GREETING_TIMEOUT=7
# Auto re-dial ONCE if the first call is a no-answer / dropped / too-short call.
# A real "wrong number" or "confirmed" is never retried.
BLAND_RETRY_ON_NOANSWER=true
BLAND_RETRY_WAIT=20
CALL_POLL_SECONDS=15
CALL_POLL_TIMEOUT=300

# ── Phase 1 brain — local Ollama (LLM judge; rules fallback) ─────────
# Start it with:  ollama serve   &&   ollama pull llama3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=60

# ── Phase 2 — MSG91 WhatsApp / SMS ───────────────────────────────────
# Requires a verified WhatsApp Business number + approved template in MSG91.
# Common 401 (apiError 418) causes, check in this order:
#   1. Authkey missing/malformed here (no quotes, no spaces).
#   2. IP security: MSG91 whitelists IPs by default. Add your public IP
#      (run: curl ifconfig.me) to the authkey's whitelist, OR toggle IP
#      security OFF for that authkey in the panel (fine for a prototype).
#   3. Authkey rule must permit the WhatsApp service.
#   4. MSG91_WA_NUMBER + MSG91_WA_TEMPLATE must match what's provisioned.
MSG91_AUTHKEY=
MSG91_WA_NUMBER=
MSG91_WA_TEMPLATE=verify_contact
MSG91_WA_LANG=en

# ── Tuning ───────────────────────────────────────────────────────────
MAX_WORKERS=1
VERIFIED_THRESHOLD=60
REVIEW_THRESHOLD=30
